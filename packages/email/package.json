{
	"name": "@repo/email",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Localized React Email templates and one sendEmail() over the chosen provider. Logs to the console in development without a key.",
	"exports": {
		".": "./src/index.ts",
		"./keys": "./src/keys.ts"
	},
	"scripts": {

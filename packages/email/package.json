		"react": "catalog:",
		"react-dom": "catalog:",
		"react-email": "6.11.3",
		"resend": "6.34.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}

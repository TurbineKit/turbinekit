{
	"name": "@repo/auth",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "better-auth: email and password, Google and GitHub, passkeys, two-factor, API keys, and the OAuth server for MCP clients.",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./keys": "./src/keys.ts",
		"./oauth": "./src/oauth.ts",
		"./permissions": "./src/permissions.ts"
	},
	"scripts": {
		"generate": "auth generate --config src/cli.ts --output ../db/src/schema/auth.ts --yes",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"grant-admin": "node src/grant-admin.ts"
	},
	"dependencies": {
		"@better-auth/api-key": "catalog:",
		"@better-auth/cimd": "catalog:",
		"@better-auth/mcp": "catalog:",
		"@better-auth/oauth-provider": "1.7.13",
		"@better-auth/passkey": "catalog:",
		"@repo/db": "workspace:*",
		"@repo/email": "workspace:*",
		"@repo/i18n": "workspace:*",
		"@repo/site": "workspace:*",
		"@t3-oss/env-core": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@electric-sql/pglite": "catalog:",
		"@repo/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"auth": "catalog:",
		"next": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"next": "^16"
	}
}

{
	"name": "@repo/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "shadcn/ui components on Base UI, the design tokens and the global stylesheet.",
	"exports": {
		"./globals.css": "./src/styles/globals.css",
		"./postcss.config": "./postcss.config.mjs",
		"./lib/*": "./src/lib/*.ts",
		"./components/*": "./src/components/*.tsx",
		"./hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"class-variance-authority": "0.7.1",
		"cn": "0.5.0",
		"input-otp": "1.5.0",
		"lucide-react": "1.61.0",
		"next-themes": "0.4.6",
		"shadcn": "4.22.1",
		"sonner": "2.0.8",
		"tw-animate-css": "1.4.0"
	},
	"devDependencies": {
		"@repo/tsconfig": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
		"@tailwindcss/typography": "0.5.20",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	}
}

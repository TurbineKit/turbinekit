# Copy to apps/web/.env.local. Next.js reads it; the database scripts and the
# auth CLI read the same file. Nothing here is needed for `pnpm build`.
# create-turbinekit writes this file for you, with a fresh secret.

# --- Site ---
# The public origin. Canonical URLs, sitemaps, share cards and auth callbacks
# use it. On Vercel, the production URL is used when this is empty.
SITE_URL=http://localhost:3000

# --- Database (Postgres) ---
# `docker compose up -d` or `pnpm db:local` (no Docker) both serve this URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# A direct (unpooled) URL for migrations, when your provider has a pooler.
DATABASE_URL_UNPOOLED=
# With `pnpm db:local` (PGlite), set 1: it runs one query at a time.
DATABASE_POOL_MAX=

# --- Auth (better-auth) ---
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Extra origins allowed to call auth, comma-separated (custom domains, apps).
BETTER_AUTH_TRUSTED_ORIGINS=
# Google and GitHub sign-in turn on when both keys are set (SETUP.md, Auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email ---
# The sender, on a domain your provider verified (SPF, DKIM, DMARC).
EMAIL_FROM="TurbineKit <hello@mail.example.com>"
# `console` prints emails instead of sending them (local, CI, e2e tests).
EMAIL_TRANSPORT=console
RESEND_API_KEY=
# #region turbinekit:email-sdk
# Email SDK uses every provider configured below, in order, with fallback.
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# #endregion turbinekit:email-sdk

# #region turbinekit:files
# --- Files (Files SDK) ---
# `local` (default) keeps files in .storage/; `s3` works with any S3-compatible
# store (Cloudflare R2, AWS S3, MinIO); `vercel-blob` uses Vercel Blob.
STORAGE_DRIVER=local
STORAGE_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BLOB_READ_WRITE_TOKEN=
# #endregion turbinekit:files

# #region turbinekit:docs
# --- API docs (Blume) ---
# The docs deployment, served at /docs. Locally: http://localhost:4321
DOCS_ORIGIN=http://localhost:4321
# #endregion turbinekit:docs

# #region turbinekit:analytics
# --- Analytics (PostHog) ---
# Project token (phc_…). Empty: analytics is off. Turn on "Cookieless server
# hash mode" in the project settings, or cookieless events are dropped.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (US Cloud) or https://eu.i.posthog.com (EU Cloud).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Source-map upload at build time (personal API key with error-tracking write).
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# #endregion turbinekit:analytics

# #region turbinekit:payments
# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# #endregion turbinekit:payments

# --- Cron ---
# Vercel Cron sends it as a bearer token to /api/cron/*.
CRON_SECRET=
